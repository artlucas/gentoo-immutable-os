out/
*.log
# MkDocs virtualenv for the developer documentation (docs/requirements.txt).
.venv/
site/
config/keys/*.gpg
config/keys/*.asc
.claude/settings.local.json.tmp.*
# Claude Code session state, none of it project content:
#   worktrees/ holds live `git worktree` checkouts of this same repo — committing one nests a
#   working tree inside the branch it was cut from. Anything shared (a project settings.json,
#   CLAUDE.md) is deliberately NOT ignored here.
.claude/worktrees/
.claude/settings.local.json
.claude/RESUME.md

# Obsidian's vault state for plan/. Editor config, not project content: workspace.json alone
# records which panes were open and changes on every scroll.
plan/.obsidian/

# ZCode session state, same rule as .claude above: nothing here is project content.
.zcode/
