# imagedeploy — write the payload to disk and mount the result (plan/16 §5.1, §5.2).
#
# Replaces the stock `unpackfs` and `mount`. Every path here is a build-time fact rendered by
# stage 40 from the same variables that produced the payload, so the module never has to guess
# what it is installing.
---
# Where stage 40 staged the payload inside the LIVE image. Under /var because stage 60 builds
# the root EROFS with --exclude '/var/*'. Only var-base.tar.zst and manifest.json actually live
# here now (plan/34 §7.1) — root.erofs is not a staged file at all any more, see liveRootPartLabel
# below.
payloadDir:    "@PAYLOAD_DIR@"
varBase:       "var-base.tar.zst"
manifest:      "manifest.json"

# The root image is no longer a file under payloadDir (plan/34 §7.2 step 6): it is THIS
# medium's own root partition, dd'd there directly by stage 60 and never staged a second time.
# imagedeploy reads it by finding the live session's own `/` — findmnt -no SOURCE / — and
# checking that partition's PARTLABEL against liveRootPartLabel before trusting it as the
# source. Not /usr: the systemd-sysext extension overlays /usr only, so `/` itself is still
# backed by whatever device this medium's own UKI cmdline named at root=PARTLABEL=....
liveRootPartLabel: "@IMG_ROOT_PARTLABEL@"

# Which partition RECEIVES the root image, by PARTLABEL. This string is the installed system's
# identity: the UKI cmdline says root=PARTLABEL=root_@VERSION@, baked in at build time and
# identical on every machine, so the label the partitioner writes and the label the initrd looks
# for have to be the same string. The `disksetup` job creates it, out of the layout in
# scripts/lib/layout.sh (plan/24); this finds it.
rootPartLabel: "@ROOT_PARTLABEL@"

# The live user's own account name, so imagedeploy's post-install check can confirm none of
# this build's own live-session state (its home, its upper passwd entry, the sysext itself)
# reached the installed disk's /var.
liveUser: "@LIVE_USER@"
