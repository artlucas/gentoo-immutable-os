# imageidentity — the per-machine settings no stock module covers (plan/16 §5.4).
---
# The autologin drop-in, written ONLY when the accounts page's checkbox asked for it (plan/26
# §4). The installed system's /etc ships no autologin config of its own to override — plan/34
# §5 moved 10-autologin.conf out of the read-only root entirely, into the live medium's own
# overlay upper — so the not-requested case needs no file at all, and this name is only ever
# used when autologin is being turned on.
autologinDropIn: "/etc/plasmalogin.conf.d/20-autologin.conf"

# Subordinate ID ranges for rootless podman (plan/13). The same window stage 40 gives the live
# user, and for the same reason: without it every `distrobox` call fails at first use, months
# after the install.
subidStart: 100000
subidCount: 65536

# The image's first-boot hostname unit skips itself when this file exists. Without it, the
# hostname typed on the users page is overwritten on the installed system's very first boot.
hostnameStamp: "/var/lib/@DISTRO_ID@/hostname-init.done"
