# Calamares branding for @DISTRO_NAME@ (plan/16).
#
# componentName MUST equal this directory's name, or Branding.cpp bails at startup.
#
# THE LOGO IS NOT A NEW ASSET. logo.png is written at build time by
# config/branding/make-splash-assets.py --logo, from the same compose_block() that produces the
# boot splash's stub bitmap and its KMS sprite tiles. Three consumers, one layout function: the
# user sees this sidebar within a minute of watching that splash, so the two must be the same
# block of pixels rather than two drawings of one logo that drift apart.
#
# ONE LAYOUT FUNCTION, TWO GROUNDS, since plan/28. The installer is the design system's LIGHT
# theme and the boot splash is still dark, so logo.png and slide.png are flattened onto
# --surface-page (#f6f7f9) while the splash keeps #0a0d11 — `--bg` is the argument that says
# which, stage 40 passes it for those two artefacts only, and tests/test-splash-assets.sh pins
# both. SidebarBackground below is that same #f6f7f9, so the PNG still has no visible edge; the
# thing that changed is which colour "no visible edge" means.
---
componentName:  installer

welcomeStyleCalamares:  false
welcomeExpandingLogo:   true

windowExpanding:    normal
# 1024x640 since plan/28, from 900x600. The design system's pages are two- and three-column
# grids — the applications page is three app-set cards across, the accounts page puts the domain
# and its local fallback side by side — and at 900px wide, less the 190px sidebar, none of them
# had the room. 1024 is also the floor the `screen` requirement already checks for
# (Calamares::windowMinimumWidth), so this cannot ask for a window wider than a medium the
# greeting page is willing to install from. Every page scrolls and every grid collapses to one
# column under its own threshold, so a smaller screen stacks rather than clips.
windowSize:         1024px,640px
windowPlacement:    center
# QML, not widget, for one reason (plan/26 §5): the widget sidebar centres every step name in
# ProgressTreeDelegate.cpp — a hard-coded Qt::AlignHCenter inside app-admin/calamares that no
# branding file can reach — and this installer's steps read better from the left. The QML flavour
# loads calamares-sidebar.qml from the branding directory BEFORE the compiled-in stock one
# (utils/Qml.cpp's search order), so the copy beside this file is ours by filename alone: the
# same file as upstream's, with the step text left-aligned and given a margin. The bottom
# navigation bar stays widget; it was never the problem.
sidebar:            qml
# QML for BOTH panels since plan/28. The navigation bar was widget because "it was never the
# problem" — it is now, for the same reason the sidebar was: a widget bar draws Breeze's buttons
# in Breeze's metrics, beside nine pages that draw the design system's. calamares-navigation.qml
# is loaded from this directory by the same filename convention and the same searchQmlFile() call
# as the sidebar, and it is upstream's file with its three Buttons redrawn.
navigation:         qml

strings:
    productName:         "@DISTRO_NAME@"
    shortProductName:    "@DISTRO_NAME@"
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "@DISTRO_NAME@ @VERSION@"
    shortVersionedName:  "@DISTRO_NAME@ @VERSION@"
    # systemd-boot reads its entry title out of the UKI's own .osrel section, not from anything
    # Calamares writes, so this string is display-only here. It is set to the same text anyway,
    # because a branding string that disagrees with the boot menu is a bug waiting to be filed.
    bootloaderEntryName: "@DISTRO_NAME@"
    productUrl:          "@HOME_URL@"
    supportUrl:          "@HOME_URL@"
    knownIssuesUrl:      "@HOME_URL@"
    releaseNotesUrl:     "@HOME_URL@"

images:
    # THE WINDOW ICON IS CALAMARES' OWN (plan/32 §2). `productIcon` has exactly one reader —
    # CalamaresApplication::initBranding()'s setWindowIcon() — and it was pointed at logo.png,
    # so the window, the task switcher and the title bar wore a 144x212 brand block squeezed into
    # a square icon box. The stock icon has been on this medium all along: src/calamares's own
    # CMakeLists installs data/images/squid.svg as the path below, which is what
    # calamares.desktop's `Icon=calamares` and our autostart copy of it already resolve to. Only
    # the window disagreed with the panel.
    #
    # AN ABSOLUTE PATH, NOT THE ICON NAME "calamares", and the difference is silent. Branding's
    # loader accepts either — it falls back to QIcon::fromTheme() and keeps the bare name when
    # the file is not in this directory — but the consumer is QIcon( QString ), which is the FILE
    # constructor. A name would therefore pass the branding's own validation and produce a null
    # icon, with no warning and no log line. QDir::absoluteFilePath() returns an absolute argument
    # unchanged, so the path reaches setWindowIcon() intact; stage 40 checks that the file is in
    # the target, because Calamares reports a missing branding image at startup, on the medium.
    productIcon:         "/usr/share/icons/hicolor/scalable/apps/calamares.svg"
    # OURS, both of them, and they stay the composed block: the sidebar is the one place in this
    # installer a brand lockup belongs. productWelcome has no reader here at all — the greeting
    # page draws no logo, and tests/test-installer.sh asserts it.
    productLogo:         "logo.png"
    productWelcome:      "logo.png"

# THE LIGHT SURFACE, since plan/28, and these four keys invert with the theme. They were the
# design system's DARK palette — the only branded surface in the installer when the other nine
# steps were Breeze — and the whole installer is the light palette now. Resolved from
# project/tokens: --surface-page #f6f7f9, --text-body #363e4a, --text-strong #161b21, and the
# accent wash (color-mix(in srgb, --accent 14%, --surface-card)) for the current step. See
# config/branding/README.md, which is where these values are recorded rather than invented.
#
# NOTHING BUT THE WIDGET FALLBACKS READS THESE ANY MORE. Both panels are QML and both instantiate
# Theme.qml, which stage 40 stages into this directory — so the keys are here for the flavours
# this branding does not select, and they are kept correct so that selecting one is a change of
# shape rather than a change of colour.
style:
    SidebarBackground:        "#f6f7f9"
    SidebarText:              "#363e4a"
    SidebarTextCurrent:       "#161b21"
    SidebarBackgroundCurrent: "#ddf1ef"

# MANDATORY, and it is the only key in this file that is. Branding.cpp reads it through get(),
# which throws YAML::KeyNotFound for a missing key, and the constructor turns that into
#
#   ERROR: FATAL in "/etc/calamares/branding/installer/branding.desc" key not found: slideshow
#
# — an immediate exit, before any window is drawn. It was omitted here on the reasoning that this
# install is minutes of dd rather than an hour of package transactions, so there is nothing to
# advertise and Calamares would show its progress list. That reasoning was wrong twice: the key
# is required, and an EMPTY list is not neutral either — SlideshowPictures falls back to
# ":/data/images/squid.svg", i.e. Calamares' own mascot, on our installer's progress page
# (Slideshow.cpp:236).
#
# So: one slide, ours. slide.png is written at build time by make-splash-assets.py --slide, from
# the same compose_block() as the logo and the boot splash, painted on the same #0a0d11 and sized
# 640x360 — because SlideshowPictures uses QLabel::setPixmap and does NOT scale the image
# (Slideshow.cpp:280), so the file must arrive at the size it will occupy.
#
# A LIST, not a QML path: the list form needs no QML runtime, no slideshowAPI, and no second
# language in the branding component. With one entry the timer still runs and re-displays the
# same image, which is exactly the intended "static brand panel".
slideshow:
    - "slide.png"

# No upload server: `uploadServer` offers to paste the installation log to a public pastebin, and
# that log names the machine's disks and the account being created. Not something an installer
# should offer to send anywhere by default.
uploadServer:
    type:   "none"
    url:    ""
    sizeLimit: -1
