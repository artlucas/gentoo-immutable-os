# Calamares top-level configuration for @DISTRO_NAME@ (plan/16).
#
# GENERATED from config/calamares/settings.conf.in by stage 40 into /etc/calamares/settings.conf,
# which is the first path Calamares looks in (libcalamares/Settings.cpp: CMAKE_INSTALL_FULL_
# SYSCONFDIR "/calamares/settings.conf"). It exists ONLY in the `installer` profile.
#
# WHAT IS DIFFERENT ABOUT THIS INSTALLER, in one paragraph, because it explains every choice
# below: installing @DISTRO_NAME@ is not unpack-and-configure. There is no squashfs to rsync, no
# package manager to run, no bootloader to generate and no fstab to write — the root filesystem
# is an EROFS image that gets written to a partition byte-for-byte, and everything else was
# decided at build time and is already inside it. So the stock modules that made sense here were
# the ones that ASK THE USER SOMETHING plus the ones that write per-machine identity into /etc.
#
# SINCE plan/28 THERE ARE NO STOCK PAGES LEFT. Every screen in the sequence below is this
# project's: the language list and the greeting (plan/22, plan/23), the disk (plan/24), the
# accounts question (plan/21), the applications question (plan/25), and — new with the design
# system — the location, the keyboard, the summary and the finished page (plan/28 §6). The stock
# `locale` and `keyboard` modules were also JOBS, and those moved to `localesetup` and
# `keyboardsetup` in the exec list. What is still upstream's is everything that writes identity
# into /etc and the exec phase's own progress page.
---

# `local` is <libdir>/calamares/modules — upstream's own modules, exactly as the ebuild installed
# them. The second entry is ours, kept in a separate directory rather than dropped in beside
# upstream's so that "which of these did we write?" is answered by the path.
modules-search: [ local, /usr/share/calamares/local-modules ]

sequence:
- show:
  # THE LANGUAGE IS THE FIRST SCREEN, and this module is ours (plan/22). It replaces the stock
  # `welcome` module, which put the requirements check and an expanding logo above its language
  # combo box and offered no configuration key that changed either.
  #
  # It is the module that calls QQuickStyle::setStyle(), because that call is ignored once any QML
  # has imported Qt Quick Controls and this entry is the one that loads first. Nothing may be
  # inserted above it without moving that call: the accounts page would come up in Fusion with no
  # icons, and the only symptom is a page that looks wrong.
  #
  # It is why config/profiles/installer.conf keeps INCLUDE_CJK_FONTS=1: two of the nine rows in
  # config/languages.conf are CJK, and without those fonts they render as tofu on the one page
  # that exists to be read.
  - language
  # THEN THE GREETING, in the language just chosen (plan/23). Ours too, and it is the module that
  # owns the six requirement checks — a requirement is contributed by whichever module is in the
  # sequence, so they belong to the page that reports the verdict. Its Next is the installer's
  # first real gate: it stays disabled until the mandatory checks pass.
  #
  # `greeting` and not `welcome`: a compiled viewmodule of that name would collide file-for-file
  # with app-admin/calamares' own, and ModuleManager resolves a duplicate name by taking whichever
  # modules-search entry it reached first. The sidebar still says "Welcome".
  - greeting
  # WHERE THE MACHINE IS, and since plan/28 §6 this is ours. It replaces the stock `locale`
  # module, whose locale half asked a question the language page had already answered — through
  # LCLocaleDialog, a list of raw locale codes behind a button with no key that relabels it.
  # modules/locale.conf said this replacement was coming; modules/location.conf is what it became.
  # The zone symlink is `localesetup`'s, below.
  #
  # `location` and not `locale`: a compiled viewmodule of that name would collide file-for-file
  # with app-admin/calamares' own.
  - location
  # WHICH KEYBOARD, ours since plan/28 §6 for the same reason and one more: the stock page's
  # preview is a QWidget that parses the xkb symbols files by hand, and libxkbcommon — which is on
  # this medium already — answers the same question exactly. The target's KEYMAP and X11 config
  # are `keyboardsetup`'s, below.
  #
  # `keymap` and not `keyboard`, the same collision.
  - keymap
  # THE DISK, and since plan/24 this is ours too. It asks one question — which disk — and it is a
  # disk picker in its own right rather than the stock partition editor with its controls
  # configured away: rows that name the machine's disks by what is printed on them and what is on
  # them now, the disks that cannot be used listed with the reason, a to-scale picture of what is
  # about to happen, and one checkbox that has to be ticked before Next lights up.
  #
  # It is NOT called `partition`: a compiled viewmodule of that name would collide file-for-file
  # with app-admin/calamares' own, and ModuleManager resolves a duplicate name by taking whichever
  # modules-search entry it reached first, silently. The sidebar says "Disk".
  - disk
  # Who will use this computer, as ONE choice: local accounts only, a managed system, or an
  # enterprise domain (plan/21). A compiled Calamares view module from the in-repo Portage
  # overlay, because Calamares accepts only C++ QtPlugin views — but MANDATORY, unlike the
  # enrolment page it replaces: it is the installer's only account-creation step, so it is named
  # unconditionally here and stage 40 refuses to build a medium whose lock did not carry it.
  # settings.conf naming a module that is installed nowhere is a step Calamares silently drops,
  # and dropping this one produces an install that reaches "finished" with no account on it.
  - accounts
  # The last question, and the only one whose absence the install survives in full: which extra
  # applications to add from Flathub — the typical set, nothing, or a chosen list (plan/25).
  # AFTER the accounts page, because it is the one question that cannot invalidate any other:
  # everything before it describes the machine being built, this describes what goes on top, and
  # a user who backs out of the summary should meet it as the last thing they chose, not the
  # first. Ours too, and for the same reason as the four above; the work is the `appsetup` job's.
  # Offline the page forces its own second answer — nothing extra — and stays a page, because an
  # offline install is a supported path this installer was built around.
  - apps
  # THE LAST SCREEN BEFORE THE ERASE, and ours since plan/28 §6. It asks every preceding step for
  # its prettyStatus() and draws them as a table, then names the disk in the design system's
  # danger tone — where the stock page rendered each step's prettyDescription() as a heading and a
  # paragraph, in Breeze.
  #
  # `review` and not `summary`, the same collision as the two above.
  - review
- exec:
  # 1. The disk. Writes the GPT and creates the two filesystems there are to make, from
  #    scripts/lib/layout.sh — the pipeline's OWN layout function, installed on this medium as
  #    /usr/libexec/<id>-disk-layout, so an installed machine and an image dd'd to a disk are
  #    partitioned by one description rather than two (plan/24 §4). The two root slots are created
  #    UNFORMATTED: there is nothing to mkfs, because what goes in them is an image.
  #
  #    A separate module from the page above, and it has to be: a Calamares view step owns its
  #    jobs(), so replacing stock `partition`'s page replaced its partitioner as well.
  - disksetup
  # 2. Our three. Between them they are the whole install (plan/16 §5.1): write the root EROFS
  #    into slot A, mount the target the way the initrd does — /etc overlay included — seed
  #    /var, and put systemd-boot and the UKI on the ESP.
  - imagedeploy
  - imagebootloader
  # 3. Identity, into the mounted target's /etc. These two were stock modules — the JOB halves of
  #    the `locale` and `keyboard` view steps — until plan/28 §6 replaced the pages those jobs
  #    belonged to. They are ours now, in Python beside the four other job modules, and they work
  #    for the reason the stock ones did: imagedeploy mounted an overlay on /etc, so their writes
  #    land in the upper on /var (§5.2). No patching required.
  #
  #    `localesetup` re-symlinks /etc/localtime, which is all SetTimezoneJob ever did.
  #    `keyboardsetup` writes /etc/vconsole.conf and /etc/X11/xorg.conf.d/00-keyboard.conf, and
  #    resolves the console keymap through the TARGET's /usr/share/systemd/kbd-model-map — the
  #    same file systemd-localed reads on the installed machine, where upstream used a copy
  #    compiled into Calamares' own binary.
  - localesetup
  - keyboardsetup
  # 3b. The accounts page's decision, applied: the local administrator (useradd/chpasswd under
  #     chroot, which works for the same overlay reason), /etc/hostname and /etc/hosts, and then
  #     whichever of the two central-identity paths was chosen — the domain join, or moving the
  #     enrolment the PAGE already made into the target and applying its bundle offline.
  #     Replaces the stock `users` module and our own `managedenroll`, which were two jobs for
  #     one decision (plan/21 §5).
  #
  #     THE LIVE USER GOES AWAY HERE TOO, at the end of this same job, on an erase — `userdel` in
  #     the target, which rewrites /etc/{passwd,shadow,group,gshadow}, a copy-up under the /etc
  #     overlay exactly as §5.4 asks for. The stock `removeuser` module used to do this as its own
  #     step; it is GONE from this list and its module.conf deleted (plan/33 §7): stock
  #     `removeuser` runs unconditionally, and a KEEPING install may have booted a factory image
  #     whose only account is the live one — `userdel -f -r live` would delete the one home
  #     directory the whole feature exists to keep. Folding it into accountsetup keeps the
  #     ordering this project already relied on (the real account exists before the live one
  #     goes) and lets it stand down exactly like every other job diskKeepData gates.
  - accountsetup
  # 4. What no stock module covers: subordinate UID/GID ranges, the autologin drop-in that turns
  # the live medium's autologin OFF, and the locale/machine-id fixups this image needs. In
  # managed mode there is no local username in GlobalStorage, so it skips the subuid range and
  # says so — correct, because the managed client owns those ranges for managed users.
  - imageidentity
  # 4b. The applications page's decision, downloaded (plan/25 §5). LAST of the chroot work, for
  #     two reasons that are the same reason: everything before it writes the machine, this adds
  #     to it, and the one failure it can meet — a download that did not finish — must not run
  #     after a job that would have reacted to it. It installs the refs the page published and
  #     then updates every flatpak in the target, so the payload's build-time pins (apps.lock)
  #     are lifted to what Flathub has today. Offline it does nothing at all, on its own
  #     re-checked verdict, and that is the whole job.
  - appsetup
  - umount
- show:
  # THE LAST PAGE, ours since plan/28 §6. It keeps upstream's two configuration keys by their own
  # names — restartNowMode and restartNowCommand — and drops notifyOnFinished, which was false
  # here and always had been.
  #
  # `done` and not `finished`, the same collision as the three above.
  - done

branding: installer

# The point of no return gets an explicit prompt. Every install here is a whole-disk erase, so
# there is exactly one screen between the user and losing their data, and it should say so.
prompt-install: true

# false: the target is a real root filesystem mounted at rootMountPoint, and target commands run
# under chroot. `accountsetup` needs that — it runs useradd/chpasswd AND, on an erase, userdel for
# the live user (plan/33 §7 folded stock `removeuser`'s job in). (The domain join and the managed
# apply deliberately run on the HOST instead, with --root naming the target, which is what keeps
# the live medium itself unenrolled.)
dont-chroot: false
oem-setup: false

disable-cancel: false
# Past `disksetup` the disk has been rewritten; cancelling there would leave a machine with a
# fresh GPT, no bootloader and no root. Better to finish and let the user retry.
disable-cancel-during-exec: true
hide-back-and-next-during-exec: true
quit-at-end: false
