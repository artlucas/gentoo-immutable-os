# Module metadata. `name` MUST equal this directory's name or ModuleManager silently skips it
# (ModuleManager::doInit compares the two and only warns when the descriptor is otherwise valid).
---
type:       "job"
name:       "managedenroll"
interface:  "python"
script:     "main.py"
# Bounded by the client's own network timeouts, not by disk work: one HTTPS round trip to the
# control plane, or one connection that never answers. Small on purpose — a weight that claimed
# otherwise would make the progress bar stall here on every install that never enrols.
weight:     2
