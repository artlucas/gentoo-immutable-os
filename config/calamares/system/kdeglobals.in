# The live medium's one KDE-wide default — plan/16.
#
# LIVE MEDIUM ONLY. Stage 40 writes this file for the `installer` profile and asserts its absence
# from every other one; the product image ships no /etc/xdg/kdeglobals at all.
#
# The /etc/xdg layer, like baloofilerc and kscreenlockerrc: KConfig cascades $XDG_CONFIG_DIRS
# underneath ~/.config, so this is the image's default and anything the live user changes in
# System Settings is written to ~/.config/kdeglobals and wins.
#
# ONE key, and it buys exactly one thing: the Look-and-Feel package below ships a Plasma layout
# script, and a layout script is the only supported way to change what the Icons-Only Task
# Manager pins (see contents/layouts/org.kde.plasma.desktop-layout.js for why a config file
# cannot). ShellCorona::setupLookAndFeel() reads this key; ShellCorona::loadDefaultLayout() then
# takes layouts/org.kde.plasma.desktop-layout.js from the package it names.
#
# Everything else about the session stays Breeze. That is not luck: the package this points at
# ships nothing but its metadata and that one script, and plasma-workspace's LookAndFeelPackage
# structure installs org.kde.breeze.desktop as the fallback package for any id that is not
# Breeze's own, so splash, lock screen, logout, colours and style all still resolve to Breeze.

[KDE]
LookAndFeelPackage=@DISTRO_ID@-installer
