# KInfoCenter's "About this System" module is branded by exactly this file. kcm_about-distro
# reads it with KConfig::NoGlobals from the first kcm-about-distrorc in $XDG_CONFIG_DIRS —
# /etc/xdg, here, the same layer ksplashrc and kdeglobals sit on — and takes every value below
# as an override of its os-release fallback:
#
#   LogoPath   what the page draws at the top, through Kirigami.Icon at 128px. Without it the
#              module walks os-release's LOGO (which this image's os-release does not set) down
#              to the hardcoded "start-here-kde" — somebody else's mark on our About page. The
#              file is the logomark — the three slabs, no wordmark — generated by
#              config/branding/make-splash-assets.py (stage 40, beside splash.bin in the same
#              directory), left transparent so it composites onto whatever colour scheme the
#              user runs. The wordmark stays out because Name below is already the page's
#              headline, and the slabs' teal needs no ink tuned to a colour scheme.
#   Name       the OS name the page leads with. Also in os-release; restated so the page's
#              identity is all in one file, the way an OEM's would be.
#   Website    the page's one link. Falls back to HOME_URL, which this file would shadow —
#              but both render from build.conf's HOME_URL, so they cannot disagree.
#
# Keys the module also reads and this file deliberately omits: Version/Variant (os-release's
# VERSION_ID and VARIANT answer those already) and ExtraSoftwareData (no third-party versions
# to report).

[General]
Name=@DISTRO_NAME@
LogoPath=/usr/share/@DISTRO_ID@/about-mark.svg
Website=@HOME_URL@
