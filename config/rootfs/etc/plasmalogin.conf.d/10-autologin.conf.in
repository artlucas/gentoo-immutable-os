# Plasma Login Manager config for @DISTRO_NAME@ — v1 images double as live media (plan/01).
# /etc is an overlay backed by /var/overlay/etc, so this stays editable on a running machine.
#
# A drop-in, not a replacement config: kde-plasma/plasma-login-manager's ebuild installs its
# own /etc/plasmalogin.conf.d/01gentoo.conf (it blanks InputMethod to drop the
# qtvirtualkeyboard default). The 10- prefix sorts after it, so both apply.
#
# PLM is a fork of SDDM and keeps its config syntax, so [Autologin] User/Session/Relogin
# carry over unchanged. CONFIRMED against plasma-login-manager 6.6.6's own Configuration.h: the
# section is [Autologin], the keys are User/Session/Relogin, and Session names a file in
# .../wayland-sessions with the ".desktop" appended for you, so "plasma" is right.
#
# THE FILE BEING CORRECT IS NOT ENOUGH, and this is the trap to know about before editing it:
# PLM only reads this directory when its newest mtime beats a zero-initialised "already loaded"
# stamp, so every inode in the image needs a non-zero mtime or nothing here is ever parsed and
# the greeter comes up with no error logged anywhere. Stage 60 stamps SOURCE_DATE_EPOCH for
# exactly this reason; it shipped as -T0 (the Unix epoch) through 0.3.0, and autologin was dead
# in every one of those images. Stage 70 now asserts autologin=yes so it cannot regress quietly.
#
# Session names /usr/share/wayland-sessions/plasma.desktop, installed by
# kde-plasma/plasma-login-sessions[wayland]. Stage 40 asserts that file exists for exactly
# this reason. No [General] or [Wayland] compositor block belongs here: PLM drives kwin
# itself, which is why it RDEPENDs kwin[lock].
[Autologin]
User=@LIVE_USER@
Session=plasma
Relogin=false
