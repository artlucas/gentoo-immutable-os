# plymouthd config for @DISTRO_NAME@. Lands in the image's /etc lower dir, so it can be
# overridden through the /etc overlay (plan/01) without touching the read-only root.
#
# ShowDelay and DeviceTimeout repeat what plymouth's own plymouthd.defaults currently sets.
# They are pinned here anyway, for the same reason the unit preset spells out its disables
# rather than trusting vendor presets: a distribution default that changes under us would show
# up as a splash that appears late or not at all, on the one screen no test in this repo looks
# at. UseSimpledrm is deliberately NOT set — this kernel has no simpledrm (checked against the
# built image's modules.builtin/modules.dep), and setting it would make dracut's plymouth
# module depend on a "simpledrm" module that pulls in nothing.
[Daemon]
Theme=@DISTRO_ID@
ShowDelay=0
DeviceTimeout=8
