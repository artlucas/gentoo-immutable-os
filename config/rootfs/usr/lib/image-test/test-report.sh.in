#!/usr/bin/env bash
# In-guest self-reporting test hook (plan/07). Runs ONLY when the QEMU harness
# injects the @DISTRO_ID@.test SMBIOS credential — never on real hardware.
# Prints one machine-readable line to the console, then powers off.
set -u

ID="@DISTRO_ID@"
MARKER="IMAGE-TEST:"
CONSOLE=/dev/console

report() { echo "$MARKER $*" > "$CONSOLE"; }

mode="smoke"
if [[ -n ${CREDENTIALS_DIRECTORY:-} && -f $CREDENTIALS_DIRECTORY/$ID.test ]]; then
    mode="$(cat "$CREDENTIALS_DIRECTORY/$ID.test")"
fi

# let the boot settle (returns when running or degraded). Bounded: a system that never settles
# must still produce a report, otherwise the harness just times out with no information at all.
timeout 180 systemctl is-system-running --wait >/dev/null 2>&1 || true

collect_and_report() {
    # shellcheck source=/dev/null
    . /etc/os-release
    local etc_fs graphical failed failed_list machine_id var_size flatpak_remotes
    local resolved dns podman_rootless runuser_bin sound live_uid
    etc_fs="$(findmnt -no FSTYPE /etc 2>/dev/null || echo none)"
    graphical="$(systemctl is-active graphical.target >/dev/null 2>&1 && echo yes || echo no)"
    failed="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -c . || true)"
    # names too, not just a count: "failed_units=2" alone tells whoever reads the harness
    # output nothing about what to fix, and the guest is gone by the time they look.
    failed_list="$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | paste -sd, -)"
    [[ -z $failed_list ]] && failed_list=none
    machine_id="$(cat /etc/machine-id 2>/dev/null || echo none)"
    var_size="$(findmnt -bno SIZE /var 2>/dev/null || echo 0)"
    flatpak_remotes="$(flatpak remotes --system 2>/dev/null | grep -c . || true)"
    # DNS comes in two fields on purpose. "resolved" is deterministic — the unit either came
    # up or it did not — and the harness asserts on it. "dns" is a real query through nss, so
    # it depends on the network the build host is on; it is reported for diagnosis and NOT
    # asserted, or a build behind a captive portal would fail the smoke test.
    resolved="$(systemctl is-active systemd-resolved.service >/dev/null 2>&1 && echo yes || echo no)"
    dns="$(getent ahostsv4 gentoo.org >/dev/null 2>&1 && echo yes || echo no)"
    # The one field that proves the whole rootless chain at once (plan/13): CONFIG_USER_NS in
    # the kernel, the setuid newuidmap/newgidmap surviving EROFS, a subuid range for the live
    # user, and a storage driver that works on the ext4 /var. Deliberately `podman info` and not
    # `podman run` — no image is preinstalled, so anything that pulls would make this field a
    # test of the build host's network instead of the image. "na" when podman is not installed
    # (INCLUDE_DISTROBOX=0), which the harness treats as "nothing to assert".
    #
    # runuser is invoked by ABSOLUTE PATH, and that is load-bearing. It installs to /usr/sbin,
    # while Gentoo builds systemd with -Dsplit-bin=false, so a service's exec search path is
    # `/usr/local/bin:/usr/bin` with NO sbin at all (`systemd-path search-binaries-default`).
    # This script runs as a unit, so a bare `runuser` here is "command not found" — the same
    # trap that makes ldconfig.service fail 203/EXEC (see stage 40). It cost a full build cycle
    # to find, because the failure looked identical to "rootless podman is broken".
    runuser_bin=/usr/sbin/runuser
    [[ -x $runuser_bin ]] || runuser_bin=/usr/bin/runuser
    if ! command -v podman >/dev/null 2>&1; then
        podman_rootless=na
    elif [[ ! -x $runuser_bin ]]; then
        # Distinct from "no": the image is fine and the TEST cannot run. Still fails the
        # harness assertion, but names the reason instead of blaming podman.
        podman_rootless=no-runuser
    else
        podman_rootless="$("$runuser_bin" -u '@LIVE_USER@' -- \
            podman info --format '{{.Host.Security.Rootless}}' 2>/tmp/podman-info.err || echo no)"
        [[ -z $podman_rootless ]] && podman_rootless=no
    fi
    # Sound. The 0.3.0 regression this field exists for: PipeWire's user units were never
    # enabled, nothing listened on the pulse socket, and the only symptom was KDE's volume
    # applet saying "Connection to the sound service lost" on a booted desktop — every
    # assertion above stayed green.
    #
    # `pactl info` rather than `systemctl --user is-enabled`: this goes through libpulse to
    # $XDG_RUNTIME_DIR/pulse/native, the exact path the applet takes. An enablement symlink
    # that exists but never produces a live socket still reads as "enabled".
    #
    # Zero sinks is fine and is NOT what this measures — QEMU boots with no audio device. The
    # applet's failure is a connection failure, so connecting is the whole assertion.
    #
    # A user manager has to be conjured first: there is no login to piggyback on. The
    # smoke-test guest runs `-display none`, so plasmalogin has no display to open a session on
    # and autologin never happens — graphical=yes above is the SYSTEM target and says nothing
    # about a user session. The first run of this check proved it, reporting
    # "/run/user/1000: No such file or directory" and an unreachable user bus.
    #
    # enable-linger, and NOT `systemctl start user@<uid>.service`. That was tried first and
    # fails, measured in the guest:
    #
    #     user@1000.service: start operation timed out. Terminating.
    #     user@1000.service: Failed with result 'timeout'.
    #
    # logind owns user@.service. Starting it behind logind's back races the teardown logind
    # performs for a user with no sessions and no linger — /run/user/1000 does get created, but
    # the manager never reaches active, and the connect then fails for a reason that has
    # nothing to do with the sound stack. Lingering is the supported way to have a user manager
    # without a login, and with it the same probe returns
    # "Server Name: PulseAudio (on PipeWire 1.6.7)".
    #
    # It writes /var/lib/systemd/linger/@LIVE_USER@, i.e. it mutates the guest — which is
    # confined to the harness: this unit is ConditionCredential=@DISTRO_ID@.test, so it never
    # runs on real hardware or on a normally booted image.
    #
    # Polled afterwards because the socket units appear as the manager reaches sockets.target,
    # which is where stage 40's enablement symlinks take effect. 20s, and the ceiling matters
    # as much as the floor: stage 70 kills the guest at TIMEOUT=300s with KVM, and a poll long
    # enough to eat that budget would turn a clean "sound=no" report into an opaque timeout —
    # losing exactly the diagnosis the DETAIL lines below exist to preserve.
    live_uid="$(id -u '@LIVE_USER@' 2>/dev/null || true)"
    # "na" is a --console-only image correctly saying it has no sound stack: @desktop is what
    # pulls media-video/pipewire in, and pactl comes with it. Probed rather than templated from
    # CONSOLE_ONLY, so the field tracks what is actually installed.
    if ! command -v pactl >/dev/null 2>&1; then
        sound=na
    elif [[ -z $live_uid || ! -x $runuser_bin ]]; then
        sound=no-runuser
    else
        sound=no
        loginctl enable-linger '@LIVE_USER@' >/dev/null 2>&1 || true
        for _ in $(seq 20); do
            if "$runuser_bin" -u '@LIVE_USER@' -- \
                env "XDG_RUNTIME_DIR=/run/user/$live_uid" \
                pactl info >/tmp/pactl-info.out 2>/tmp/pactl-info.err; then
                sound=ok; break
            fi
            sleep 1
        done
    fi
    report "ok version=${IMAGE_VERSION:-unknown} etc_overlay=$etc_fs graphical=$graphical" \
           "failed_units=$failed machine_id=$machine_id var_size=$var_size" \
           "flatpak_remotes=$flatpak_remotes resolved=$resolved dns=$dns" \
           "podman_rootless=$podman_rootless sound=$sound" \
           "failed_list=$failed_list phase=$1"
    # Same split as podman below: the marker line stays one parseable line, the reason goes on
    # DETAIL lines while the guest still exists to say it. "sound=no" alone cannot distinguish
    # "units not enabled" from "server up but refusing the connection", and telling those two
    # apart is otherwise a rebuild.
    if [[ $sound != ok && $sound != na ]]; then
        [[ -s /tmp/pactl-info.err ]] \
            && sed "s/^/$MARKER-DETAIL pactl: /" /tmp/pactl-info.err > "$CONSOLE"
        # First thing to read: it separates "the user manager never came up" (a problem with
        # this test) from "it came up and the sound units are not enabled" (a problem with the
        # image). Without it the two look identical — both just fail to reach the user bus.
        echo "$MARKER-DETAIL user-manager: user@$live_uid.service=$(systemctl is-active "user@$live_uid.service" 2>&1)" \
            > "$CONSOLE"
        "$runuser_bin" -u '@LIVE_USER@' -- \
            env "XDG_RUNTIME_DIR=/run/user/$live_uid" \
            systemctl --user is-active pipewire-pulse.socket pipewire.service wireplumber.service 2>&1 \
            | paste -sd, - | sed "s/^/$MARKER-DETAIL pw-units: /" > "$CONSOLE"
        ls -l "/run/user/$live_uid/pulse/native" 2>&1 \
            | sed "s/^/$MARKER-DETAIL pulse-socket: /" > "$CONSOLE"
    fi
    # Why it failed, while the guest still exists to say so. The marker line above is a single
    # parseable line by design, so the reason goes on its own DETAIL lines — the same split
    # dump_failed uses for failed units. Without this, "podman_rootless=no" is indistinguishable
    # between a broken image and a broken test, and telling them apart costs a rebuild.
    if [[ $podman_rootless != true && $podman_rootless != na ]]; then
        echo "$MARKER-DETAIL podman_rootless=$podman_rootless runuser=$runuser_bin" > "$CONSOLE"
        [[ -s /tmp/podman-info.err ]] \
            && sed "s/^/$MARKER-DETAIL podman: /" /tmp/podman-info.err > "$CONSOLE"
        "$runuser_bin" -u '@LIVE_USER@' -- id 2>&1 \
            | sed "s/^/$MARKER-DETAIL id: /" > "$CONSOLE"
        grep "^@LIVE_USER@:" /etc/subuid /etc/subgid 2>&1 \
            | sed "s/^/$MARKER-DETAIL /" > "$CONSOLE"
    fi
}

# When units failed, put their status on the console too. The guest powers off moments later,
# so this is the only chance to see WHY; the marker line itself stays single-line and parseable.
dump_failed() {
    local u
    for u in $(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}'); do
        echo "$MARKER-DETAIL unit=$u" > "$CONSOLE"
        systemctl status --no-pager --lines=8 "$u" 2>&1 | sed "s/^/$MARKER-DETAIL /" > "$CONSOLE"
    done
}

case "$mode" in
smoke)
    collect_and_report boot
    dump_failed
    systemctl poweroff
    ;;
update)
    state="/var/lib/$ID/update-test.state"
    if [[ ! -f $state ]]; then
        # phase 1 (old version): point transfers at the test server, apply, poweroff.
        if [[ -n ${CREDENTIALS_DIRECTORY:-} && -f $CREDENTIALS_DIRECTORY/$ID.update_url ]]; then
            url="$(cat "$CREDENTIALS_DIRECTORY/$ID.update_url")"
            mkdir -p /etc/sysupdate.d
            for t in /usr/lib/sysupdate.d/*.transfer; do
                sed "s|^Path=http.*|Path=$url|" "$t" > "/etc/sysupdate.d/$(basename "$t")"
            done
        fi
        if "$ID-update" apply; then
            mkdir -p "/var/lib/$ID"; touch "$state"
            collect_and_report update-applied
        else
            report "fail reason=update-apply version=$(. /etc/os-release; echo "$IMAGE_VERSION")"
        fi
        systemctl poweroff
    else
        # phase 2 (new version booted): normal report.
        rm -f "$state"
        collect_and_report post-update
        systemctl poweroff
    fi
    ;;
*)
    report "fail reason=unknown-mode mode=$mode"
    systemctl poweroff
    ;;
esac
