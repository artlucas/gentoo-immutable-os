# Vendor preset for @DISTRO_NAME@ — applied at build time (stage 40).
# preset-mode=enable-only is used, so absent units and vendor defaults are unaffected.
enable NetworkManager.service
# preset-all applies VENDOR presets too, which enable systemd-networkd — so the image booted
# with two network managers and systemd-networkd-wait-online.service failed (no networkd links
# to wait for).
# NetworkManager owns the network here (plan/03). These disables run before stage 50 deletes
# networkd from the image outright, so that no enablement symlink is left pointing at a unit
# file that is about to disappear.
disable systemd-networkd.service
disable systemd-networkd.socket
disable systemd-networkd-wait-online.service
disable systemd-networkd-wait-online@.service
# networkd's kernel-cmdline (ip=) config generator — useless with no networkd to configure.
disable systemd-network-generator.service
# DNS: resolved is the only resolver in the image (/etc/nsswitch.conf uses the "resolve"
# module, /etc/resolv.conf is its stub, NetworkManager feeds it over D-Bus). Its own vendor
# preset is "enable" on most builds, but this image must not depend on that.
enable systemd-resolved.service
# The display manager. Its [Install] section is Alias=display-manager.service — the same
# mechanism gdm used — so nothing else in the preset flow changes with the swap. Stage 40
# asserts the alias symlink actually got written, because a preset that quietly did not
# take produces an image that boots to a console with no error anywhere.
enable plasmalogin.service
enable bluetooth.service
enable systemd-timesyncd.service
enable fstrim.timer
enable systemd-boot-check-no-failures.service
enable @DISTRO_ID@-boot-ok.service
enable @DISTRO_ID@-test-report.service
enable @DISTRO_ID@-flatpak-preinstall.service
enable @DISTRO_ID@-hostname-init.service
disable sshd.service
# ---- Active Directory (plan/18 §5.1) -------------------------------------------------------
# sssd ships in every profile (@domain) and must NOT start until the machine has actually been
# joined. This is a boot-integrity rule, not tidiness: systemd-boot-check-no-failures.service
# above gates boot-complete.target, so a unit that starts and fails is a FAILED BOOT — the try
# counter is not cleared and three of them roll the machine back to the previous image. sssd
# exits non-zero with no /etc/sssd/sssd.conf, which is exactly what an unjoined machine has.
#
# `<distro>-domain join` enables sssd.service; `leave` disables it again. The unit also carries
# ConditionPathExists=/etc/sssd/sssd.conf as an independent second defence (a preset that quietly
# did not take has broken an image here before), and stage 40 asserts that no sssd* enablement
# symlink survives into the built image — which is the check that catches any responder unit not
# named below.
disable sssd.service
disable sssd-kcm.service
disable sssd-kcm.socket
disable sssd-nss.socket
disable sssd-pam.socket
disable sssd-pam-priv.socket
disable sssd-autofs.socket
disable sssd-ssh.socket
disable sssd-sudo.socket
disable sssd-ifp.service
# The PAC responder, which arrives with USE=samba (--enable-pac-responder). It is a Kerberos
# ticket-authorisation-data service for an IPA/AD setup that evaluates group membership from the
# PAC; nothing here does. Same rule as every unit above it.
disable sssd-pac.service
disable sssd-pac.socket
# winbind, from net-fs/samba[winbind], which sssd[samba] demands. THIS IMAGE HAS TWO DOMAIN
# CLIENTS INSTALLED AND RUNS EXACTLY ONE. sssd is it; winbindd is a build-time consequence of
# the flag that carries sssd's AD provider, and it is not named `sssd*`, so the stage-40
# "no sssd enablement symlink" assertion would not have caught it. Started unjoined, with no
# usable smb.conf, it fails — and a failed unit here is a failed boot and a rollback, which is
# the whole reason this block exists. Stage 40 asserts this one by name.
disable winbind.service
disable winbindd.service
disable systemd-sysupdate.timer
# Containers are ROOTLESS here (plan/13): podman runs inside the user's own session, under
# their subuid range, with storage in ~/.local/share/containers. The system-wide units are
# what a rootful daemon would need, and this image has no rootful containers at all — so the
# API socket, the restart-on-boot helper and the auto-update timer are off in the vendor
# preset, for the same reason sshd.service above is. The per-user copies under
# /usr/lib/systemd/user are untouched; nothing enables them either.
# Stage 50 asserts no podman.socket enablement symlink survives.
disable podman.service
disable podman.socket
disable podman-restart.service
disable podman-auto-update.timer
disable podman-clean-transient.service
# ---- managed mode (plan/19 §8.1) ------------------------------------------------------------
# The policy-sync timer must NOT be enabled on an image that has never enrolled, for exactly the
# reason sssd above must not be: systemd-boot-check-no-failures.service gates
# boot-complete.target, so a unit that starts and fails is a failed boot, and three of those roll
# the machine back to the previous image.
#
# The sync client itself exits 0 on every path (plan/19 §4.1) and the service carries a
# ConditionPathExists drop-in, so this is the outermost of three independent defences — and the
# only one that keeps the timer from even appearing in `systemctl list-timers` on a machine
# nobody has enrolled. `<distro>-managed enroll` enables it; `leave` disables it again, and
# stage 40 asserts that no <distro>-managed* enablement symlink survives into the built image.
disable @DISTRO_ID@-managed-sync.timer
disable @DISTRO_ID@-managed-sync.service
