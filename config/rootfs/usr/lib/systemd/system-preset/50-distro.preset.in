# Vendor preset for @DISTRO_NAME@ — applied at build time (stage 40).
# preset-mode=enable-only is used, so absent units and vendor defaults are unaffected.
enable NetworkManager.service
# preset-all applies VENDOR presets too, which enable systemd-networkd — so the image booted
# with two network managers and systemd-networkd-wait-online.service failed (no networkd links
# to wait for).
# NetworkManager owns the network here (plan/03). These disables run before stage 50 deletes
# networkd from the image outright, so that no enablement symlink is left pointing at a unit
# file that is about to disappear.
disable systemd-networkd.service
disable systemd-networkd.socket
disable systemd-networkd-wait-online.service
disable systemd-networkd-wait-online@.service
# networkd's kernel-cmdline (ip=) config generator — useless with no networkd to configure.
disable systemd-network-generator.service
# DNS: resolved is the only resolver in the image (/etc/nsswitch.conf uses the "resolve"
# module, /etc/resolv.conf is its stub, NetworkManager feeds it over D-Bus). Its own vendor
# preset is "enable" on most builds, but this image must not depend on that.
enable systemd-resolved.service
# The display manager. Its [Install] section is Alias=display-manager.service — the same
# mechanism gdm used — so nothing else in the preset flow changes with the swap. Stage 40
# asserts the alias symlink actually got written, because a preset that quietly did not
# take produces an image that boots to a console with no error anywhere.
enable plasmalogin.service
enable bluetooth.service
enable systemd-timesyncd.service
enable fstrim.timer
enable systemd-boot-check-no-failures.service
enable @DISTRO_ID@-boot-ok.service
enable @DISTRO_ID@-test-report.service
enable @DISTRO_ID@-flatpak-preinstall.service
enable @DISTRO_ID@-hostname-init.service
disable sshd.service
disable systemd-sysupdate.timer
