EAPI=8

inherit cmake

DESCRIPTION="Calamares view module: the @DISTRO_NAME@ installer's language page"
HOMEPAGE="@HOME_URL@"
# No SRC_URI — see the sibling ebuilds and ../../README.md.
S="${WORKDIR}/${P}"

# GPL-3 rather than GPL-2+: this links against libcalamares, which is GPL-3-or-later, so the
# combined work cannot be distributed under anything weaker.
LICENSE="GPL-3"
SLOT="0"
KEYWORDS="amd64"

# Everything the long note in distro-calamares-accounts' ebuild says about DEPEND applies here
# unchanged, and is not repeated: app-admin/calamares is a DEPEND because DEPEND is what portage
# installs into ESYSROOT, ESYSROOT here is the BUILDER root rather than the target, and most of
# this list is not "what the code includes" but "what CalamaresConfig.cmake re-finds when
# find_package(Calamares) runs" — qtsvg, qttools[linguist] and yaml-cpp among them.
#
# WHAT IS DIFFERENT ABOUT THIS ONE, in two lines:
#
#   - no libpwquality and no cracklib. There is no password on this page.
#   - no -DDISTRO_ID. The accounts page execs /usr/bin/<id>-managed and /usr/bin/<id>-domain and
#     therefore needs the distro's id at compile time; this page execs nothing at all. Its only
#     inputs are its own .conf and libcalamares, and its only output is one GlobalStorage key.
DEPEND="
	>=app-admin/calamares-3.4.0
	>=dev-qt/qtbase-6.7.0:6[gui,network,widgets]
	>=dev-qt/qtdeclarative-6.7.0:6
	>=dev-qt/qtsvg-6.7.0:6
	>=dev-qt/qttools-6.7.0:6[linguist]
	>=kde-frameworks/kcoreaddons-6.9.0:6
	dev-cpp/yaml-cpp:0=
"
# NOT ${DEPEND}, for the two reasons the sibling ebuild records: qttools is a CONFIGURE-time
# requirement only (CalamaresConfig.cmake asks for Qt6LinguistTools; nothing here links against
# it), and kirigami is the opposite — it appears in no #include and no link line, and the page does
# not render without it, because `import org.kde.kirigami` is resolved by the QML engine at runtime
# out of /usr/lib64/qt6/qml. qqc2-desktop-style is named for the same reason: LanguageViewStep asks
# QQuickStyle for org.kde.desktop, and without the package the controls fall back to the Basic
# style, which on this page costs the icons as well as the metrics.
#
# Both are already on the installer medium as dependencies of Plasma, so naming them costs no atom
# — and it means a future prune that decides Plasma's QML modules are not needed on a medium that
# boots once fails on this package's dependencies instead of on a blank first screen.
RDEPEND="
	>=app-admin/calamares-3.4.0
	>=dev-qt/qtbase-6.7.0:6[gui,network,widgets]
	>=dev-qt/qtdeclarative-6.7.0:6
	>=dev-qt/qtsvg-6.7.0:6
	>=kde-frameworks/kcoreaddons-6.9.0:6
	>=kde-frameworks/kirigami-6.9.0:6
	>=kde-frameworks/qqc2-desktop-style-6.9.0:6
	dev-cpp/yaml-cpp:0=
"
BDEPEND="
	>=dev-qt/qtbase-6.7.0:6
	virtual/pkgconfig
"

# This package is ONLY for the installer profile. On a target image it would install a Calamares
# module into a system that has no Calamares — harmless, and still wrong, because the package audit
# would then have to explain why an installer plugin is on a desktop.
src_unpack() {
	mkdir -p "${S}" || die
	cp -r "${FILESDIR}"/. "${S}"/ || die
	# Every file cp -r just copied got the CURRENT WALL-CLOCK TIME as its mtime, and Qt's rcc
	# embeds a .qml resource's own mtime into the generated C++ (QQmlEngine's disk-cache
	# invalidation key) — confirmed by direct reproduction on distro-kcm-managed's identical
	# src_unpack pattern (see its ebuild for the full story, including why a flat @0 stamp is
	# ALSO wrong: verifyHeader() treats a zero embedded mtime as invalid and falls back to the
	# systemsettings BINARY's own mtime instead — constant across rebuilds via a reused binpkg
	# — which would silently break cache invalidation across a real content change). The stamp
	# has to be deterministic across two builds of the same source AND different when the
	# source itself differs, so it is derived from each file's own content hash. Directories
	# and symlinks keep a fixed, nonzero stamp; only regular files get a content-derived one.
	find "${S}" \( -type d -o -type l \) -exec touch -h -d @1 -- {} + || die
	while IFS= read -r -d '' f; do
		h=$(sha256sum -- "${f}" | cut -c1-8) || die
		touch -h -d "@$(( 16#${h} + 1 ))" -- "${f}" || die
	done < <(find "${S}" -type f -print0)
}

src_configure() {
	local mycmakeargs=(
		# Calamares' own build sets this; out of tree it has to be asked for by name, or
		# calamares_add_plugin installs into ${CMAKE_INSTALL_LIBDIR}/calamares/modules relative
		# to a prefix that is not the one Calamares itself used.
		-DCMAKE_INSTALL_LIBDIR="$(get_libdir)"
	)
	cmake_src_configure
}

pkg_postinst() {
	elog "This module is MANDATORY: it is the installer's first page, and it is where"
	elog "QQuickStyle::setStyle() has to happen for every later QML page to have icons."
	elog "settings.conf names it unconditionally and stage 40 refuses to build a medium without"
	elog "it (plan/22 §3)."
	elog
	elog "The six requirement checks it used to own belong to the sibling 'greeting' module since"
	elog "plan/23, and so does the greeting screen that displayed them."
}
