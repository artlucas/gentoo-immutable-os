# Copyright 2026 @DISTRO_NAME@
# Distributed under the terms of the GNU General Public License v3

EAPI=8

inherit cmake

DESCRIPTION="Calamares view module: the @DISTRO_NAME@ installer's summary page"
HOMEPAGE="@HOME_URL@"
# No SRC_URI — see the sibling ebuilds and ../../README.md.
S="${WORKDIR}/${P}"

# GPL-3 rather than GPL-2+: this links against libcalamares, which is GPL-3-or-later, so the
# combined work cannot be distributed under anything weaker.
LICENSE="GPL-3"
SLOT="0"
KEYWORDS="amd64"

# Everything the long note in distro-calamares-accounts' ebuild says about DEPEND applies here
# unchanged and is not repeated: app-admin/calamares is a DEPEND because DEPEND is what portage
# installs into ESYSROOT, ESYSROOT here is the BUILDER root rather than the target, and most of
# this list is not "what the code includes" but "what CalamaresConfig.cmake re-finds when
# find_package(Calamares) runs" — qtsvg, qttools[linguist] and yaml-cpp among them.
#
# This module's own additions are qtdeclarative and nothing else. It reads no device, runs no
# process and asks no network: every row on the page is another view step's prettyStatus(), taken
# through Calamares' own ViewManager.
DEPEND="
	>=app-admin/calamares-3.4.0
	>=dev-qt/qtbase-6.7.0:6[gui,widgets]
	>=dev-qt/qtdeclarative-6.7.0:6
	>=dev-qt/qtsvg-6.7.0:6
	>=dev-qt/qttools-6.7.0:6[linguist]
	>=kde-frameworks/kcoreaddons-6.9.0:6
	dev-cpp/yaml-cpp:0=
"
# NOT ${DEPEND}, and for the two reasons the accounts ebuild gives. qttools is a CONFIGURE-time
# requirement only — nothing links against it. kirigami and qqc2-desktop-style are the opposite:
# they appear in no #include and no link line, and the page does not render without them, because
# `import org.kde.kirigami` is resolved by the QML engine at runtime out of /usr/lib64/qt6/qml and
# QQuickStyle asks for org.kde.desktop. Both are already on the medium as Plasma dependencies, so
# naming them costs no atom and makes a future prune fail here instead of on a blank page.
RDEPEND="
	>=app-admin/calamares-3.4.0
	>=dev-qt/qtbase-6.7.0:6[gui,widgets]
	>=dev-qt/qtdeclarative-6.7.0:6
	>=dev-qt/qtsvg-6.7.0:6
	>=kde-frameworks/kcoreaddons-6.9.0:6
	>=kde-frameworks/kirigami-6.9.0:6
	>=kde-frameworks/qqc2-desktop-style-6.9.0:6
	dev-cpp/yaml-cpp:0=
"
BDEPEND="
	>=dev-qt/qtbase-6.7.0:6
	virtual/pkgconfig
"

# This package is ONLY for the installer profile. On a target image it would install a Calamares
# module into a system that has no Calamares — harmless, and still wrong, because the package
# audit would then have to explain why an installer plugin is on a desktop.
src_unpack() {
	mkdir -p "${S}" || die
	cp -r "${FILESDIR}"/. "${S}"/ || die
	# Every file cp -r just copied got the CURRENT WALL-CLOCK TIME as its mtime. Qt's rcc
	# embeds a .qml resource's own mtime into the C++ it generates (QQmlEngine's disk-cache
	# invalidation key), so two otherwise-identical builds of this package, run moments
	# apart, would link a byte-different .so purely from that — confirmed by direct
	# reproduction on distro-kcm-managed's identical src_unpack pattern (see its ebuild).
	# This module's own view is QML too. Pinned here for the same reason.
	find "${S}" -exec touch -h -d @0 -- {} + || die
}

src_configure() {
	local mycmakeargs=(
		# Calamares' own build sets this; out of tree it has to be asked for by name, or
		# calamares_add_plugin installs into ${CMAKE_INSTALL_LIBDIR}/calamares/modules relative
		# to a prefix that is not the one Calamares itself used.
		-DCMAKE_INSTALL_LIBDIR="$(get_libdir)"
	)
	cmake_src_configure
}

pkg_postinst() {
	elog "This module is MANDATORY. It is the last screen before the exec phase and the only one"
	elog "that names the disk about to be erased; a medium without it would go from the"
	elog "applications page straight into the erase, with nothing in the log saying the step was"
	elog "dropped."
	elog
	elog "It is called 'review' rather than 'summary' because calamares_add_plugin installs a"
	elog "viewmodule into <libdir>/calamares/modules/<name>/, so that name would collide"
	elog "file-for-file with app-admin/calamares' own module and be blocked by portage."
}
